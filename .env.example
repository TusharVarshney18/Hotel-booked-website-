# Database (Postgres in production, e.g. Neon/Supabase)
DATABASE_URL="postgresql://user:password@host:5432/aurelia?schema=public"

# Session signing (generate with: openssl rand -base64 32)
SESSION_SECRET="replace-me"

# Public origin used in magic-link emails
APP_URL="http://localhost:3000"

# Email delivery (Resend). When unset, magic links are logged to the console.
RESEND_API_KEY=""
EMAIL_FROM="Aurelia <no-reply@aurelia.example>"

# Payments (Razorpay)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Rate limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
